<Window x:Class="SISMA.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SISMA - Sistem Informasi Mahasiswa (ETS PBKK C - 5025241264)"
        Height="760" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- KPI Cards -->
            <RowDefinition Height="*"/>    <!-- Content: Form + DataGrid -->
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎓 SISMA" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,10,0"/>
                        <Border Background="#2563EB" CornerRadius="4" Padding="8,2">
                            <TextBlock Text="ETS DESKTOP RICH UI" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Sistem Informasi Mahasiswa Berbasis WPF XAML &amp; SQL Server LocalDB" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Muhammad Hilman Azhar" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"/>
                    <TextBlock Text="NRP: 5025241264 • Kelas PBKK C" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. KPI Cards Row -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Mahasiswa -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOTAL MAHASISWA" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="txtKpiTotal" Text="0" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                    <TextBlock Text="Terdaftar di Database" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Rata-Rata IPK -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16,12" Margin="5,0,5,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="RATA-RATA IPK" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="txtKpiIpk" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                    <TextBlock Text="Skala 4.00" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Mahasiswa Aktif -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16,12" Margin="5,0,5,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="STATUS MAHASISWA" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="txtKpiStatus" Text="0 Aktif / 0 Cuti" FontSize="20" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                    <TextBlock Text="Rasio Keaktifan Kuliah" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Database Status -->
            <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="16,12" Margin="10,0,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="DATABASE ENGINE" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="10" Height="10" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="SQL Server LocalDB" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock Text="DbSismaPBKK (Online)" FontSize="11" Foreground="#10B981"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Main Workspace: Form (Left) & DataGrid (Right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Form Input & Aksi -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="txtFormTitle" Text="📝 Formulir Entri Mahasiswa" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtFormSubtitle" Text="Silakan isi data mahasiswa di bawah ini" FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>

                        <!-- NRP -->
                        <TextBlock Text="NRP (Nomor Registrasi Mahasiswa) *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtNrp" Padding="8,6" FontSize="13" Margin="0,0,0,12" BorderBrush="#CBD5E1"/>

                        <!-- Nama -->
                        <TextBlock Text="Nama Lengkap *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtNama" Padding="8,6" FontSize="13" Margin="0,0,0,12" BorderBrush="#CBD5E1"/>

                        <!-- Email -->
                        <TextBlock Text="Email Kampus *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtEmail" Padding="8,6" FontSize="13" Margin="0,0,0,12" BorderBrush="#CBD5E1"/>

                        <!-- Prodi -->
                        <TextBlock Text="Program Studi *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbProdi" Padding="8,6" FontSize="13" Margin="0,0,0,12">
                            <ComboBoxItem Content="Teknik Informatika" IsSelected="True"/>
                            <ComboBoxItem Content="Sistem Informasi"/>
                            <ComboBoxItem Content="Teknik Komputer"/>
                            <ComboBoxItem Content="Sains Data"/>
                            <ComboBoxItem Content="Teknologi Informasi"/>
                        </ComboBox>

                        <!-- Angkatan & IPK (2 Kolom) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Angkatan *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbAngkatan" Padding="8,6" FontSize="13">
                                    <ComboBoxItem Content="2021"/>
                                    <ComboBoxItem Content="2022"/>
                                    <ComboBoxItem Content="2023"/>
                                    <ComboBoxItem Content="2024" IsSelected="True"/>
                                    <ComboBoxItem Content="2025"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="IPK (0.00 - 4.00) *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtIpk" Text="3.50" Padding="8,6" FontSize="13" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                        </Grid>

                        <!-- Status -->
                        <TextBlock Text="Status Akademik *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbStatus" Padding="8,6" FontSize="13" Margin="0,0,0,20">
                            <ComboBoxItem Content="Aktif" IsSelected="True"/>
                            <ComboBoxItem Content="Cuti"/>
                        </ComboBox>

                        <!-- Action Buttons -->
                        <Button x:Name="btnSimpan" Content="💾 Simpan Data Baru" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="0,10" Cursor="Hand" Click="btnSimpan_Click" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnUpdate" Grid.Column="0" Content="✏️ Ubah Data" Background="#059669" Foreground="White" FontWeight="Bold" Padding="0,8" Cursor="Hand" Click="btnUpdate_Click" IsEnabled="False"/>
                            <Button x:Name="btnHapus" Grid.Column="2" Content="🗑️ Hapus" Background="#DC2626" Foreground="White" FontWeight="Bold" Padding="0,8" Cursor="Hand" Click="btnHapus_Click" IsEnabled="False"/>
                        </Grid>

                        <Button x:Name="btnReset" Content="🔄 Reset Formulir" Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" Padding="0,8" Cursor="Hand" Click="btnReset_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel: Search & DataGrid -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search & Controls -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Search Bar Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="📋 Daftar Mahasiswa Terdaftar" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>

                        <TextBox x:Name="txtSearch" Grid.Column="1" Margin="20,0,10,0" Padding="10,6" FontSize="13" BorderBrush="#CBD5E1" TextChanged="txtSearch_TextChanged"/>
                        <TextBlock Grid.Column="1" Text="🔍 Cari NRP, Nama, atau Prodi..." FontSize="12" Foreground="#94A3B8" IsHitTestVisible="False" VerticalAlignment="Center" Margin="32,0,0,0"
                                   Visibility="{Binding Text.IsEmpty, ElementName=txtSearch, Converter={StaticResource BoolToVis}}"/>

                        <Button x:Name="btnRefresh" Grid.Column="2" Content="🔄 Refresh" Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" Padding="14,6" Cursor="Hand" Click="btnRefresh_Click"/>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid x:Name="dgMahasiswa" Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              Background="Transparent"
                              RowHeight="36"
                              FontSize="13"
                              SelectionChanged="dgMahasiswa_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NRP" Binding="{Binding Nrp}" Width="120" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Nama Lengkap" Binding="{Binding Nama}" Width="200"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                            <DataGridTextColumn Header="Program Studi" Binding="{Binding Prodi}" Width="150"/>
                            <DataGridTextColumn Header="Angkatan" Binding="{Binding Angkatan}" Width="80"/>
                            <DataGridTextColumn Header="IPK" Binding="{Binding Ipk, StringFormat=F2}" Width="60"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Waktu Daftar" Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
